# --- NASA FIRMS (optional) ---

NASA_FIRMS_API_KEY=589f3fcc0e83401d2456a66a3042c3a6
NASA_FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv



# --- OSM / Overpass (optional) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter



# --- Database (Optional) ---
# Default: Local SQLite (thermaguard.db) created automatically. No setup or link needed!
# To use external PostgreSQL instead, uncomment and add your link:
# DATABASE_URL=postgresql://user:password@localhost:5432/thermaguard


# --- Persistence detection thresholds ---
PERSISTENCE_RADIUS_KM=1.5
PERSISTENCE_MIN_COUNT=3



# --- Industrial proximity threshold (km) used for "industrial zone" features ---
INDUSTRIAL_PROXIMITY_KM=5.0



# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
